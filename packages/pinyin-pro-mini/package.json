{
  "name": "pinyin-pro-mini",
  "version": "3.28.2",
  "description": "pinyin-pro 的轻量版本，仅包含单字拼音字典",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "typings": "./types/index.d.ts",
  "scripts": {
    "build": "rollup -c && rollup -c rollup.esm.config.js",
    "test": "vitest run"
  },
  "files": ["dist", "types"],
  "keywords": ["pinyin", "汉字", "拼音"],
  "author": "zh-lx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zh-lx/pinyin-pro.git",
    "directory": "packages/pinyin-pro-mini"
  },
  "homepage": "https://pinyin-pro.cn",
  "exports": {
    ".": {
      "import": { "types": "./types/index.d.ts", "default": "./dist/index.mjs" },
      "require": { "types": "./types/index.d.ts", "default": "./dist/index.js" }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@pinyin-pro/data": "workspace:^",
    "@rollup/plugin-alias": "^3.1.9",
    "@rollup/plugin-commonjs": "^17.1.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^11.2.0",
    "rollup": "2.60.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^4.2.3",
    "vitest": "^1.5.0"
  },
  "sideEffects": false
}
