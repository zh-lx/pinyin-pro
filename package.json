{
  "name": "pinyin-pro-repository",
  "version": "1.0.0",
  "private": true,
  "description": "The monorepo for pinyin-pro, @pinyin-pro/data and pinyin-pro documentation.",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter @pinyin-pro/data build && pnpm --filter pinyin-pro build",
    "build:docs": "pnpm --filter @pinyin-pro/docs build",
    "build:all": "pnpm build:packages && pnpm build:docs",
    "deploy:docs": "bash ./deploy.sh",
    "test": "pnpm --filter pinyin-pro test",
    "lint": "pnpm --filter pinyin-pro lint",
    "compare": "pnpm --filter pinyin-pro compare",
    "size": "pnpm --filter pinyin-pro size",
    "speed": "pnpm --filter pinyin-pro speed",
    "accuracy": "pnpm --filter pinyin-pro accuracy",
    "docs:dev:zh": "pnpm --filter @pinyin-pro/docs-zh docs:dev",
    "docs:dev:en": "pnpm --filter @pinyin-pro/docs-en docs:dev",
    "data:validate": "pnpm --filter @pinyin-pro/data validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zh-lx/pinyin-pro.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/pinyin": "^1.7.7",
    "@types/node": "^26.2.0",
    "pinyin": "^4.0.0",
    "ts-node": "^10.9.2"
  }
}
